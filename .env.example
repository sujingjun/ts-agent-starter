# 不需要模型密钥的离线演示。
MODEL_MODE=demo
STORE_MODE=file
EXECUTION_MODE=inline
LOCAL_TENANT_ID=local
# 运行 scripts/init-env.mjs 自动生成随机访问令牌；不是模型 API key。
API_AUTH_TOKEN=
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# 实际使用时填写模型供应商提供的兼容接口配置；不要提交 .env。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_STREAM=false
LLM_STREAM_USAGE=false
ALLOW_LOCAL_MODEL=false
TAVILY_API_KEY=
DATABASE_URL=
WORKSPACE_ROOT=
ENABLE_SANDBOX=false

# 官方框架检查点：memory 不支持进程重启恢复；postgres 需先执行 migrate:graph。
CHECKPOINT_MODE=memory
# 只有显式开启才上传 trace；生产使用前审查敏感数据。
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ts-agent-starter
LANGSMITH_API_KEY=
